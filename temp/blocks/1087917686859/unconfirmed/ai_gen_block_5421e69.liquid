{% doc %}
  @prompt
    feature product section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-product-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #111111;
  }

  .ai-featured-product-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }

  .ai-featured-product-{{ ai_gen_id }}__media {
    display: block;
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    border-radius: {{ block.settings.corner_radius }}px;
    aspect-ratio: 1 / 1;
  }

  .ai-featured-product-{{ ai_gen_id }}__media img,
  .ai-featured-product-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-product-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    color: #666666;
  }

  .ai-featured-product-{{ ai_gen_id }}__empty {
    position: absolute;
    inset: auto 16px 16px;
    padding: 10px 14px;
    background: #ffffff;
    color: #333333;
    text-align: center;
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-featured-product-{{ ai_gen_id }}__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .ai-featured-product-{{ ai_gen_id }}__eyebrow {
    margin: 0;
    color: #333333;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-featured-product-{{ ai_gen_id }}__title {
    margin: 0;
    color: inherit;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.12;
  }

  .ai-featured-product-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-featured-product-{{ ai_gen_id }}__price {
    font-size: 18px;
    font-weight: 600;
  }

  .ai-featured-product-{{ ai_gen_id }}__compare-price {
    margin-inline-start: 8px;
    color: #555555;
    font-size: 15px;
    font-weight: 400;
  }

  .ai-featured-product-{{ ai_gen_id }}__description {
    color: #333333;
    line-height: 1.6;
  }

  .ai-featured-product-{{ ai_gen_id }}__description > *:first-child {
    margin-top: 0;
  }

  .ai-featured-product-{{ ai_gen_id }}__description > *:last-child {
    margin-bottom: 0;
  }

  .ai-featured-product-{{ ai_gen_id }}__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid #111111;
    border-radius: 14px;
    background: #111111;
    color: #ffffff;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-featured-product-{{ ai_gen_id }}__button:hover {
    background: #333333;
    border-color: #333333;
  }

  .ai-featured-product-{{ ai_gen_id }}__button:focus-visible,
  .ai-featured-product-{{ ai_gen_id }}__title a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .ai-featured-product-{{ ai_gen_id }}__button[disabled] {
    background: #555555;
    border-color: #555555;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-product-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstyle %}

<div class="ai-featured-product-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% assign featured_product = block.settings.product %}
  {% if featured_product != blank %}
    <div class="ai-featured-product-{{ ai_gen_id }}__inner">
      <a class="ai-featured-product-{{ ai_gen_id }}__media" href="{{ featured_product.url }}" aria-label="{{ featured_product.title | escape }}">
        {% if featured_product.featured_image %}
          {{ featured_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1400', alt: featured_product.featured_image.alt | default: featured_product.title | escape }}
        {% else %}
          <div class="ai-featured-product-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<span class="ai-featured-product-{{ ai_gen_id }}__empty">Choose a product image in your product settings</span></div>
        {% endif %}
      </a>
      <div class="ai-featured-product-{{ ai_gen_id }}__details">
        {% if block.settings.eyebrow != blank %}<p class="ai-featured-product-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
        <h2 class="ai-featured-product-{{ ai_gen_id }}__title"><a href="{{ featured_product.url }}">{{ featured_product.title | escape }}</a></h2>
        <div class="ai-featured-product-{{ ai_gen_id }}__price">
          {{ featured_product.price | money }}
          {% if featured_product.compare_at_price > featured_product.price %}<s class="ai-featured-product-{{ ai_gen_id }}__compare-price">{{ featured_product.compare_at_price | money }}</s>{% endif %}
        </div>
        {% if block.settings.show_description and featured_product.description != blank %}<div class="ai-featured-product-{{ ai_gen_id }}__description">{{ featured_product.description | strip_html | truncate: 220 }}</div>{% endif %}
        {% if featured_product.available %}
          {% assign featured_variant = featured_product.selected_or_first_available_variant %}
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ featured_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="ai-featured-product-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
          </form>
        {% else %}
          <button class="ai-featured-product-{{ ai_gen_id }}__button" type="button" disabled>{{ block.settings.sold_out_label | escape }}</button>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="ai-featured-product-{{ ai_gen_id }}__inner">
      <div class="ai-featured-product-{{ ai_gen_id }}__media">
        <div class="ai-featured-product-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<span class="ai-featured-product-{{ ai_gen_id }}__empty">Select a product to feature</span></div>
      </div>
      <div class="ai-featured-product-{{ ai_gen_id }}__details"><h2 class="ai-featured-product-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2><p>Choose a product in the block settings to show its image, price, and details.</p></div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Placeholder heading", "default": "Featured product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A favorite pick" },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold-out label", "default": "Sold out" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [
    { "name": "Featured product" }
  ],
  "tag": null,
  "class": "featured-product-block"
}
{% endschema %}