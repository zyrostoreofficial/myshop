{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 32px 24px;
  }

  .ai-timeline-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
  }

  .ai-timeline-{{ ai_gen_id }}__heading {
    margin: 0 0 32px;
    color: {{ block.settings.text_color }};
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.2;
  }

  .ai-timeline-{{ ai_gen_id }}__list {
    position: relative;
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ai-timeline-{{ ai_gen_id }}__list::before,
  .ai-timeline-{{ ai_gen_id }}__progress {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 11px;
    width: 2px;
    background: {{ block.settings.track_color }};
  }

  .ai-timeline-{{ ai_gen_id }}__progress {
    bottom: auto;
    height: var(--ai-timeline-progress, 0%);
    max-height: calc(100% - 24px);
    background: {{ block.settings.accent_color }};
    transition: height 180ms ease-out;
  }

  .ai-timeline-{{ ai_gen_id }}__item {
    position: relative;
    padding: 0 0 32px 42px;
    scroll-margin-top: 25vh;
  }

  .ai-timeline-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; }

  .ai-timeline-{{ ai_gen_id }}__marker {
    position: absolute;
    z-index: 1;
    top: 4px;
    left: 3px;
    width: 18px;
    height: 18px;
    border: 2px solid {{ block.settings.track_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker {
    border-color: {{ block.settings.accent_color }};
    background: {{ block.settings.accent_color }};
    box-shadow: 0 0 0 4px {{ block.settings.accent_color }}33;
  }

  .ai-timeline-{{ ai_gen_id }}__date {
    display: block;
    margin: 0 0 7px;
    color: {{ block.settings.accent_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .04em;
  }

  .ai-timeline-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: 21px;
    line-height: 1.3;
  }

  .ai-timeline-{{ ai_gen_id }}__copy {
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.65;
  }

  .ai-timeline-{{ ai_gen_id }}__copy p { margin: 0; }

  .ai-timeline-{{ ai_gen_id }}__item:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-timeline-{{ ai_gen_id }}__progress,
    .ai-timeline-{{ ai_gen_id }}__marker { transition: none; }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <ol class="ai-timeline-{{ ai_gen_id }}__list" aria-label="{{ block.settings.heading | default: 'Timeline' | escape }}">
      <span class="ai-timeline-{{ ai_gen_id }}__progress" aria-hidden="true"></span>
      {% for i in (1..5) %}
        {% liquid
          assign title_key = 'event_' | append: i | append: '_title'
          assign date_key = 'event_' | append: i | append: '_date'
          assign copy_key = 'event_' | append: i | append: '_text'
          assign title_value = block.settings[title_key]
          assign date_value = block.settings[date_key]
          assign copy_value = block.settings[copy_key]
        %}
        {% if title_value != blank or date_value != blank or copy_value != blank %}
          <li class="ai-timeline-{{ ai_gen_id }}__item" tabindex="0">
            <span class="ai-timeline-{{ ai_gen_id }}__marker" aria-hidden="true"></span>
            {% if date_value != blank %}<span class="ai-timeline-{{ ai_gen_id }}__date">{{ date_value | escape }}</span>{% endif %}
            {% if title_value != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ title_value | escape }}</h3>{% endif %}
            {% if copy_value != blank %}<div class="ai-timeline-{{ ai_gen_id }}__copy">{{ copy_value }}</div>{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('.ai-timeline-{{ ai_gen_id }}__item'));
        this.progress = this.querySelector('.ai-timeline-{{ ai_gen_id }}__progress');
        if (!this.items.length || !this.progress) return;
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) this.setActive(this.items.indexOf(entry.target));
          });
        }, { rootMargin: '-42% 0px -42% 0px', threshold: 0 });
        this.items.forEach((item) => {
          this.observer.observe(item);
          item.addEventListener('focus', () => this.setActive(this.items.indexOf(item)));
        });
        this.setActive(0);
      }
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }
      setActive(index) {
        this.items.forEach((item, itemIndex) => {
          const active = itemIndex === index;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-current', active ? 'step' : 'false');
        });
        const fraction = this.items.length > 1 ? index / (this.items.length - 1) : 0;
        this.style.setProperty('--ai-timeline-progress', `${fraction * 100}%`);
      }
    }
    customElements.define(tagName, ScrollTimeline{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "accent_color", "label": "Highlight", "default": "#174F3A" },
    { "type": "color", "id": "track_color", "label": "Timeline track", "default": "#B8C4BE" },
    { "type": "header", "content": "Timeline entries" },
    { "type": "text", "id": "event_1_date", "label": "Entry 1 date", "default": "The beginning" },
    { "type": "text", "id": "event_1_title", "label": "Entry 1 title", "default": "A simple idea" },
    { "type": "richtext", "id": "event_1_text", "label": "Entry 1 text", "default": "<p>Share the first milestone in your story with your customers.</p>" },
    { "type": "text", "id": "event_2_date", "label": "Entry 2 date", "default": "A new chapter" },
    { "type": "text", "id": "event_2_title", "label": "Entry 2 title", "default": "Taking shape" },
    { "type": "richtext", "id": "event_2_text", "label": "Entry 2 text", "default": "<p>Describe a moment when your vision started to become real.</p>" },
    { "type": "text", "id": "event_3_date", "label": "Entry 3 date", "default": "Growing together" },
    { "type": "text", "id": "event_3_title", "label": "Entry 3 title", "default": "Finding our community" },
    { "type": "richtext", "id": "event_3_text", "label": "Entry 3 text", "default": "<p>Tell customers how your community helped your business grow.</p>" },
    { "type": "text", "id": "event_4_date", "label": "Entry 4 date", "default": "Today" },
    { "type": "text", "id": "event_4_title", "label": "Entry 4 title", "default": "Making an impact" },
    { "type": "richtext", "id": "event_4_text", "label": "Entry 4 text", "default": "<p>Highlight what your team is working toward right now.</p>" },
    { "type": "text", "id": "event_5_date", "label": "Entry 5 date", "default": "What's next" },
    { "type": "text", "id": "event_5_title", "label": "Entry 5 title", "default": "The journey continues" },
    { "type": "richtext", "id": "event_5_text", "label": "Entry 5 text", "default": "<p>Share the future you are building with your customers.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}