{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: clamp(20px, 4vw, 56px);
    box-sizing: border-box;
  }

  .ai-editorial-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .ai-editorial-{{ ai_gen_id }}__masthead {
    border-top: 1px solid {{ block.settings.rule_color }};
    border-bottom: 1px solid {{ block.settings.rule_color }};
    padding: 12px 0;
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__masthead p { margin: 0; }
  .ai-editorial-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(220px, .8fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .ai-editorial-{{ ai_gen_id }}__lead,
  .ai-editorial-{{ ai_gen_id }}__story { min-width: 0; }

  .ai-editorial-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    aspect-ratio: 1.55 / 1;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder {
    width: 100%;
    aspect-ratio: 1.55 / 1;
    background: #efefed;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-height: 540px;
    color: #747474;
  }

  .ai-editorial-{{ ai_gen_id }}__empty {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: #fff;
    color: #222;
    padding: 6px 9px;
    font-size: 12px;
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 22px 0 10px;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ai-editorial-{{ ai_gen_id }}__title {
    color: inherit;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(32px, 5vw, {{ block.settings.heading_size }}px);
    line-height: 1.04;
    letter-spacing: -.04em;
    margin: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__summary {
    margin-top: 14px;
    max-width: 680px;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-editorial-{{ ai_gen_id }}__summary p { margin: 0; }

  .ai-editorial-{{ ai_gen_id }}__stories {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .ai-editorial-{{ ai_gen_id }}__story + .ai-editorial-{{ ai_gen_id }}__story {
    padding-top: 25px;
    border-top: 1px solid {{ block.settings.rule_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__image,
  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__placeholder {
    aspect-ratio: 1.35 / 1;
  }

  .ai-editorial-{{ ai_gen_id }}__story .ai-editorial-{{ ai_gen_id }}__eyebrow { margin-top: 14px; }

  .ai-editorial-{{ ai_gen_id }}__story-title {
    color: inherit;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.15;
    margin: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    color: inherit;
    text-decoration: none;
  }

  .ai-editorial-{{ ai_gen_id }}__link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .ai-editorial-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} { padding: 24px 18px; }
    .ai-editorial-{{ ai_gen_id }}__layout { grid-template-columns: 1fr; gap: 30px; }
    .ai-editorial-{{ ai_gen_id }}__masthead { margin-bottom: 22px; }
    .ai-editorial-{{ ai_gen_id }}__stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .ai-editorial-{{ ai_gen_id }}__story + .ai-editorial-{{ ai_gen_id }}__story { padding-top: 0; border-top: 0; }
    .ai-editorial-{{ ai_gen_id }}__story-title { font-size: 19px; }
  }

  @media screen and (max-width: 480px) {
    .ai-editorial-{{ ai_gen_id }}__stories { grid-template-columns: 1fr; }
    .ai-editorial-{{ ai_gen_id }}__masthead { font-size: 9px; }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    <div class="ai-editorial-{{ ai_gen_id }}__masthead">
      <p>{{ block.settings.section_label | escape }}</p>
      <p>{{ block.settings.issue_label | escape }}</p>
    </div>
    <div class="ai-editorial-{{ ai_gen_id }}__layout">
      <article class="ai-editorial-{{ ai_gen_id }}__lead">
        {% if block.settings.lead_image %}
          <img class="ai-editorial-{{ ai_gen_id }}__image" src="{{ block.settings.lead_image | image_url: width: 1600 }}" alt="{{ block.settings.lead_image.alt | escape }}" loading="lazy" width="{{ block.settings.lead_image.width }}" height="{{ block.settings.lead_image.height }}">
        {% else %}
          <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span class="ai-editorial-{{ ai_gen_id }}__empty">Add the lead story image</span>
          </div>
        {% endif %}
        {% if block.settings.lead_category != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.lead_category | escape }}</p>{% endif %}
        {% if block.settings.lead_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.lead_link }}"><h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.lead_title | escape }}</h2></a>{% else %}<h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.lead_title | escape }}</h2>{% endif %}
        {% if block.settings.lead_summary != blank %}<div class="ai-editorial-{{ ai_gen_id }}__summary">{{ block.settings.lead_summary }}</div>{% endif %}
      </article>
      <div class="ai-editorial-{{ ai_gen_id }}__stories">
        {% for i in (1..2) %}
          {% liquid
            assign image_key = 'story_' | append: i | append: '_image'
            assign category_key = 'story_' | append: i | append: '_category'
            assign title_key = 'story_' | append: i | append: '_title'
            assign link_key = 'story_' | append: i | append: '_link'
            assign story_image = block.settings[image_key]
            assign story_category = block.settings[category_key]
            assign story_title = block.settings[title_key]
            assign story_link = block.settings[link_key]
          %}
          <article class="ai-editorial-{{ ai_gen_id }}__story">
            {% if story_image %}
              <img class="ai-editorial-{{ ai_gen_id }}__image" src="{{ story_image | image_url: width: 800 }}" alt="{{ story_image.alt | escape }}" loading="lazy" width="{{ story_image.width }}" height="{{ story_image.height }}">
            {% else %}
              <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
                {{ 'image' | placeholder_svg_tag }}
                <span class="ai-editorial-{{ ai_gen_id }}__empty">Add story {{ i }} image</span>
              </div>
            {% endif %}
            {% if story_category != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ story_category | escape }}</p>{% endif %}
            {% if story_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ story_link }}"><h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{{ story_title | escape }}</h3></a>{% else %}<h3 class="ai-editorial-{{ ai_gen_id }}__story-title">{{ story_title | escape }}</h3>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial layout",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "section_label", "label": "Section label", "default": "The journal" },
    { "type": "text", "id": "issue_label", "label": "Issue label", "default": "Stories and ideas" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#171717" },
    { "type": "color", "id": "rule_color", "label": "Divider", "default": "#b8b8b8" },
    { "type": "range", "id": "heading_size", "label": "Lead heading size", "min": 36, "max": 72, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Lead story" },
    { "type": "image_picker", "id": "lead_image", "label": "Image" },
    { "type": "text", "id": "lead_category", "label": "Category", "default": "Featured story" },
    { "type": "text", "id": "lead_title", "label": "Headline", "default": "A fresh perspective on the everyday" },
    { "type": "richtext", "id": "lead_summary", "label": "Summary", "default": "<p>Introduce the story with a concise, engaging opening that invites readers to explore more.</p>" },
    { "type": "url", "id": "lead_link", "label": "Story link" },
    { "type": "header", "content": "Side stories" },
    { "type": "image_picker", "id": "story_1_image", "label": "Story 1 image" },
    { "type": "text", "id": "story_1_category", "label": "Story 1 category", "default": "Culture" },
    { "type": "text", "id": "story_1_title", "label": "Story 1 headline", "default": "The details that make a difference" },
    { "type": "url", "id": "story_1_link", "label": "Story 1 link" },
    { "type": "image_picker", "id": "story_2_image", "label": "Story 2 image" },
    { "type": "text", "id": "story_2_category", "label": "Story 2 category", "default": "In focus" },
    { "type": "text", "id": "story_2_title", "label": "Story 2 headline", "default": "A closer look at what inspires us" },
    { "type": "url", "id": "story_2_link", "label": "Story 2 link" }
  ],
  "presets": [{ "name": "Editorial layout" }],
  "tag": null,
  "class": "editorial-layout-block"
}
{% endschema %}