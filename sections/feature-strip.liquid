{%- comment -%}
  sections/feature-strip.liquid
  A row of 2 to 6 short selling points (delivery, returns, payment, support) with icons.
  Add, remove and edit the items from Customize. Class names start with "fs-" to avoid theme clashes.
{%- endcomment -%}

{%- style -%}
  #fs-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top | times: 0.6 | round }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round }}px;
  }

  #fs-{{ section.id }} .fs-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
  }

  #fs-{{ section.id }} .fs-heading {
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
    color: inherit;
  }

  #fs-{{ section.id }} .fs-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }

  #fs-{{ section.id }} .fs-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.07);
    margin-bottom: 1rem;
  }

  #fs-{{ section.id }} .fs-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.35rem;
    color: inherit;
  }

  #fs-{{ section.id }} .fs-text {
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.8;
  }

  @media (min-width: 750px) {
    #fs-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #fs-{{ section.id }} .fs-grid {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 2 }}, minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
  }
{%- endstyle -%}

<section id="fs-{{ section.id }}">
  <div class="fs-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fs-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="fs-grid">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="fs-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
                {%- when 'return' -%}
                  <path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v4h4"/>
                {%- when 'shield' -%}
                  <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>
                {%- when 'support' -%}
                  <path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/>
                {%- when 'cash' -%}
                  <rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>
              {%- endcase -%}
            </svg>
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="fs-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="fs-text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Feature strip",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "default": ""
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#E8EFE6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#14241C"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Secure / quality" },
            { "value": "support", "label": "Support" },
            { "value": "cash", "label": "Payment" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast delivery"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Your order is packed and shipped quickly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature strip",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "truck",
            "title": "Fast delivery",
            "text": "Your order is packed and shipped quickly."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "cash",
            "title": "Easy payment",
            "text": "Pay the way that suits you at checkout."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "return",
            "title": "Simple returns",
            "text": "Something not right? Tell us and we will help."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "support",
            "title": "Friendly support",
            "text": "Message us any time with questions."
          }
        }
      ]
    }
  ]
}
{% endschema %}
