{%- comment -%}
  sections/hero-banner.liquid  (v3: full-width image hero)
  Big image fills the section, text sits at the bottom over a soft dark gradient.
  All class names start with "hb-" so they never clash with the theme's own hero styles.
{%- endcomment -%}

{%- style -%}
  #hb-{{ section.id }} {
    --hb-text: {{ section.settings.content_color }};
    --hb-btn-bg: {{ section.settings.cta_bg }};
    --hb-btn-text: {{ section.settings.cta_text }};
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: {{ section.settings.height }}vh;
    min-height: {{ section.settings.height }}svh;
    overflow: hidden;
    background: #1f2a24;
    color: var(--hb-text);
  }

  #hb-{{ section.id }} .hb-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  #hb-{{ section.id }} .hb-media img,
  #hb-{{ section.id }} .hb-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #hb-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ section.settings.overlay | divided_by: 100.0 }}) 0%,
      rgba(0, 0, 0, 0) 85%
    );
  }

  #hb-{{ section.id }} .hb-inner {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 3rem clamp(1.25rem, 4vw, 4rem) 2.5rem;
    text-align: {{ section.settings.align }};
  }

  #hb-{{ section.id }} .hb-heading {
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.25rem, 1rem + 4.2vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
    color: var(--hb-text);
    {%- if section.settings.align == 'center' -%}
      margin-left: auto;
      margin-right: auto;
    {%- endif -%}
  }

  #hb-{{ section.id }} .hb-text {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 1rem 0 0;
    max-width: 46ch;
    color: var(--hb-text);
    {%- if section.settings.align == 'center' -%}
      margin-left: auto;
      margin-right: auto;
    {%- endif -%}
  }

  #hb-{{ section.id }} .hb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem;
    {%- if section.settings.align == 'center' -%}
      justify-content: center;
    {%- endif -%}
  }

  #hb-{{ section.id }} .hb-button {
    display: inline-block;
    padding: 0.95rem 2rem;
    border-radius: 999px;
    background: var(--hb-btn-bg);
    color: var(--hb-btn-text);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  #hb-{{ section.id }} .hb-button:hover { transform: translateY(-2px); }

  #hb-{{ section.id }} .hb-more {
    position: static;
    color: var(--hb-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
  }

  #hb-{{ section.id }} .hb-button:focus-visible,
  #hb-{{ section.id }} .hb-more:focus-visible {
    outline: 3px solid var(--hb-text);
    outline-offset: 4px;
  }

  #hb-{{ section.id }} .hb-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0.1em 0 0.14em;
    margin: -0.1em 0 -0.14em;
  }

  #hb-{{ section.id }} .hb-word__in { display: inline-block; }

  @keyframes hb-rise {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }

  @keyframes hb-fade {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: no-preference) {
    #hb-{{ section.id }}.hb-anim .hb-word__in {
      transform: translateY(110%);
      animation: hb-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      animation-delay: calc(var(--i) * 90ms + 150ms);
    }
    #hb-{{ section.id }}.hb-anim .hb-text,
    #hb-{{ section.id }}.hb-anim .hb-actions {
      opacity: 0;
      animation: hb-fade 0.7s ease forwards;
    }
    #hb-{{ section.id }}.hb-anim .hb-text { animation-delay: calc(var(--hb-n) * 90ms + 350ms); }
    #hb-{{ section.id }}.hb-anim .hb-actions { animation-delay: calc(var(--hb-n) * 90ms + 500ms); }
  }

  @media (min-width: 750px) {
    #hb-{{ section.id }} .hb-inner { padding-top: 5rem; padding-bottom: 4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #hb-{{ section.id }} .hb-button { transition: none; }
    #hb-{{ section.id }} .hb-button:hover { transform: none; }
  }
{%- endstyle -%}

{%- assign hb_words = section.settings.heading | escape | split: ' ' -%}
<section id="hb-{{ section.id }}"{% if section.settings.animate %} class="hb-anim" style="--hb-n: {{ hb_words.size }}"{% endif %}>
  <div class="hb-media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hb-inner">
    {%- if section.settings.heading != blank -%}
      {%- if section.settings.animate -%}
        <h1 class="hb-heading" aria-label="{{ section.settings.heading | escape }}">
          {%- for word in hb_words -%}
            <span class="hb-word" aria-hidden="true"><span class="hb-word__in" style="--i: {{ forloop.index0 }}">{{ word }}</span></span>{{ ' ' }}
          {%- endfor -%}
        </h1>
      {%- else -%}
        <h1 class="hb-heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hb-text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
      <div class="hb-actions">
        {%- if section.settings.button_label != blank -%}
          <a class="hb-button" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="hb-more" href="{{ section.settings.link_url | default: routes.collections_url }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh picks, delivered to your door."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Browse the new arrivals and find something you will use every day."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    },
    {
      "type": "header",
      "content": "Image and layout"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate heading on load",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 70
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark gradient strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_text",
      "label": "Button text",
      "default": "#14241C"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
