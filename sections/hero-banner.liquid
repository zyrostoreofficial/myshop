{%- comment -%}
  sections/hero-banner.liquid  (v2: full-width image hero)
  Big image fills the section, text sits at the bottom over a soft dark gradient.
  Everything is editable from Theme Editor > Customize.
{%- endcomment -%}

{%- style -%}
  #hero-{{ section.id }} {
    --hero-text: {{ section.settings.content_color }};
    --hero-btn-bg: {{ section.settings.cta_bg }};
    --hero-btn-text: {{ section.settings.cta_text }};
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: {{ section.settings.height }}vh;
    min-height: {{ section.settings.height }}svh;
    overflow: hidden;
    background: #1f2a24;
    color: var(--hero-text);
  }

  #hero-{{ section.id }} .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  #hero-{{ section.id }} .hero__media img,
  #hero-{{ section.id }} .hero__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #hero-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ section.settings.overlay | divided_by: 100.0 }}) 0%,
      rgba(0, 0, 0, 0) 70%
    );
  }

  #hero-{{ section.id }} .hero__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    text-align: {{ section.settings.align }};
  }

  #hero-{{ section.id }} .hero__heading {
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.75rem, 1rem + 7vw, 6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 13ch;
    text-wrap: balance;
    {%- if section.settings.align == 'center' -%}
      margin-left: auto;
      margin-right: auto;
    {%- endif -%}
  }

  #hero-{{ section.id }} .hero__text {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 1.25rem 0 0;
    max-width: 46ch;
    {%- if section.settings.align == 'center' -%}
      margin-left: auto;
      margin-right: auto;
    {%- endif -%}
  }

  #hero-{{ section.id }} .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
    {%- if section.settings.align == 'center' -%}
      justify-content: center;
    {%- endif -%}
  }

  #hero-{{ section.id }} .hero__button {
    display: inline-block;
    padding: 1rem 2.25rem;
    border-radius: 999px;
    background: var(--hero-btn-bg);
    color: var(--hero-btn-text);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  #hero-{{ section.id }} .hero__button:hover { transform: translateY(-2px); }

  #hero-{{ section.id }} .hero__link {
    color: var(--hero-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
  }

  #hero-{{ section.id }} .hero__button:focus-visible,
  #hero-{{ section.id }} .hero__link:focus-visible {
    outline: 3px solid var(--hero-text);
    outline-offset: 4px;
  }

  @media (min-width: 750px) {
    #hero-{{ section.id }} .hero__inner { padding: 6rem 3rem 4.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-{{ section.id }} .hero__button { transition: none; }
    #hero-{{ section.id }} .hero__button:hover { transform: none; }
  }
{%- endstyle -%}

<section id="hero-{{ section.id }}" class="hero">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="hero__button" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="hero__link" href="{{ section.settings.link_url | default: routes.collections_url }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh picks, delivered to your door."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Browse the new arrivals and find something you will use every day."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    },
    {
      "type": "header",
      "content": "Image and layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark gradient strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_bg",
      "label": "Button background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_text",
      "label": "Button text",
      "default": "#14241C"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
