{%- comment -%}
  sections/hero-banner.liquid
  Split hero: text on one side, arch-shaped image on the other.
  Everything is editable from Theme Editor > Customize.
{%- endcomment -%}

{%- style -%}
  #hero-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-btn-bg: {{ section.settings.button_bg }};
    --hero-btn-text: {{ section.settings.button_text }};
    background: var(--hero-bg);
    color: var(--hero-text);
    padding: {{ section.settings.padding_top | times: 0.6 | round }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round }}px;
  }

  #hero-{{ section.id }} .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #hero-{{ section.id }} .hero__heading {
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.5rem, 1.2rem + 5.5vw, 4.75rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 14ch;
    text-wrap: balance;
  }

  #hero-{{ section.id }} .hero__text {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 1.25rem 0 0;
    max-width: 44ch;
    opacity: 0.85;
  }

  #hero-{{ section.id }} .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  #hero-{{ section.id }} .hero__button {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 999px;
    background: var(--hero-btn-bg);
    color: var(--hero-btn-text);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  #hero-{{ section.id }} .hero__button:hover { transform: translateY(-2px); }

  #hero-{{ section.id }} .hero__link {
    color: var(--hero-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
  }

  #hero-{{ section.id }} .hero__button:focus-visible,
  #hero-{{ section.id }} .hero__link:focus-visible {
    outline: 3px solid var(--hero-text);
    outline-offset: 4px;
  }

  #hero-{{ section.id }} .hero__media {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 999px 999px 28px 28px;
    background: rgba(0, 0, 0, 0.06);
  }

  #hero-{{ section.id }} .hero__media img,
  #hero-{{ section.id }} .hero__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 750px) {
    #hero-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #hero-{{ section.id }} .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
    {%- if section.settings.image_position == 'left' -%}
      #hero-{{ section.id }} .hero__media { order: -1; }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-{{ section.id }} .hero__button { transition: none; }
    #hero-{{ section.id }} .hero__button:hover { transform: none; }
  }
{%- endstyle -%}

<section id="hero-{{ section.id }}" class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="hero__button" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a class="hero__link" href="{{ section.settings.link_url | default: routes.collections_url }}">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '480, 720, 960, 1200',
            sizes: '(min-width: 750px) 40vw, 90vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh picks, delivered to your door."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Browse the new arrivals and find something you will use every day."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Second link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#E8EFE6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#14241C"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#14241C"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
