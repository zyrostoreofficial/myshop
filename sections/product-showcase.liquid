{%- comment -%}
  sections/product-showcase.liquid
  Product grid for the homepage. Pick a collection in Customize and choose how many products to show.
  All class names start with "ps-" so they never clash with the theme's own styles.
{%- endcomment -%}

{%- style -%}
  #ps-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top | times: 0.6 | round }}px 0 {{ section.settings.padding_bottom | times: 0.6 | round }}px;
  }

  #ps-{{ section.id }} .ps-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 4rem);
  }

  #ps-{{ section.id }} .ps-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 2rem;
  }

  #ps-{{ section.id }} .ps-heading {
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(1.75rem, 1rem + 2.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    color: inherit;
  }

  #ps-{{ section.id }} .ps-all {
    position: static;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 2px;
  }

  #ps-{{ section.id }} .ps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
  }

  #ps-{{ section.id }} .ps-link {
    position: static;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #ps-{{ section.id }} .ps-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.05);
  }

  #ps-{{ section.id }} .ps-media img,
  #ps-{{ section.id }} .ps-media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #ps-{{ section.id }} .ps-img-hover { opacity: 0; transition: opacity 0.3s ease; }

  @media (hover: hover) {
    #ps-{{ section.id }} .ps-link:hover .ps-img-hover { opacity: 1; }
  }

  #ps-{{ section.id }} .ps-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    font-size: 0.8125rem;
    font-weight: 600;
  }

  #ps-{{ section.id }} .ps-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0.85rem 0 0.25rem;
    color: inherit;
  }

  #ps-{{ section.id }} .ps-price {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    margin: 0;
    font-size: 0.9375rem;
  }

  #ps-{{ section.id }} .ps-was {
    opacity: 0.55;
    text-decoration: line-through;
  }

  #ps-{{ section.id }} .ps-link:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 4px;
    border-radius: 12px;
  }

  #ps-{{ section.id }} .ps-empty {
    margin: 0 0 1.5rem;
    opacity: 0.7;
  }

  @media (min-width: 750px) {
    #ps-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
    #ps-{{ section.id }} .ps-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ps-{{ section.id }} .ps-img-hover { transition: none; }
  }
{%- endstyle -%}

{%- assign ps_collection = section.settings.collection -%}

<section id="ps-{{ section.id }}">
  <div class="ps-inner">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="ps-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ps-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="ps-all" href="{{ ps_collection.url | default: routes.all_products_collection_url }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if ps_collection != blank and ps_collection.products_count > 0 -%}
      <ul class="ps-grid">
        {%- for product in ps_collection.products limit: section.settings.limit -%}
          {%- assign ps_alt = product.featured_media.alt | default: product.title | escape -%}
          <li>
            <a class="ps-link" href="{{ product.url }}">
              <div class="ps-media">
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 800
                    | image_tag:
                      widths: '320, 480, 640, 800',
                      sizes: '(min-width: 750px) 25vw, 50vw',
                      loading: 'lazy',
                      alt: ps_alt
                  }}
                  {%- assign ps_second = product.media[1] -%}
                  {%- if ps_second != blank and ps_second.media_type == 'image' -%}
                    {{
                      ps_second
                      | image_url: width: 800
                      | image_tag:
                        widths: '320, 480, 640, 800',
                        sizes: '(min-width: 750px) 25vw, 50vw',
                        loading: 'lazy',
                        class: 'ps-img-hover',
                        alt: ''
                    }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}

                {%- if product.available == false -%}
                  <span class="ps-badge">Sold out</span>
                {%- elsif product.compare_at_price > product.price -%}
                  <span class="ps-badge">Sale</span>
                {%- endif -%}
              </div>

              <h3 class="ps-title">{{ product.title | escape }}</h3>
              <p class="ps-price">
                {%- if product.compare_at_price > product.price -%}
                  <span>{{ product.price | money }}</span>
                  <span class="ps-was">{{ product.compare_at_price | money }}</span>
                {%- elsif product.price_varies -%}
                  <span>From {{ product.price_min | money }}</span>
                {%- else -%}
                  <span>{{ product.price | money }}</span>
                {%- endif -%}
              </p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="ps-empty">Choose a collection in the theme editor to show your products here.</p>
      <ul class="ps-grid">
        {%- for i in (1..section.settings.limit) -%}
          {%- assign ps_n = forloop.index0 | modulo: 6 | plus: 1 -%}
          <li>
            <div class="ps-media">{{ 'product-' | append: ps_n | placeholder_svg_tag }}</div>
            <h3 class="ps-title">Product title</h3>
            <p class="ps-price"><span>Rs. 0.00</span></p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors and spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#14241C"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
